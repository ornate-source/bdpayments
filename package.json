{
  "name": "bdpayments",
  "version": "1.1.0",
  "description": "Centralized payment gateway abstraction for Stripe, SSLCommerz, bKash, and Nagad. One unified API for charge, refund, and retrieve.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "author": "Sabbir Mahmud",
  "license": "MIT",
  "homepage": "https://ornate-source.github.io/bdpayments/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ornate-source/bdpayments.git"
  },
  "bugs": {
    "url": "https://github.com/ornate-source/bdpayments/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "stripe": ">=12"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "stripe": "^17.7.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "payments",
    "payment-gateway",
    "stripe",
    "sslcommerz",
    "bkash",
    "nagad",
    "bangladesh",
    "unified-payments"
  ]
}
